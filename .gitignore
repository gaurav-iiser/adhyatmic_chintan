__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.DS_Store

# Keep source media, temporary audio, and any other generated data out of Git.
# Transcript artifacts and human-review audit files are durable project data.
data/*
!data/.gitkeep
!data/*/
data/*/*
!data/*/raw_transcript.txt
!data/*/raw_transcript.json
!data/*/proposed_clean_transcript.txt
!data/*/proposed_clean_transcript.json
!data/*/proposed_cleaning_report.json
!data/*/human_review_state.json
!data/*/clean_transcript.txt
!data/*/clean_transcript.json
!data/*/human_review_report.json
